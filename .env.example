# =======================================================
# Organic Farming Guide - RAG Assistant Environment Config
# =======================================================

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-pro)
GEMINI_MODEL=gemini-1.5-flash

# Embeddings: 'sentence-transformers' (default local), 'gemini', or 'local'
EMBEDDING_PROVIDER=sentence-transformers

# Admin Authentication Secret for Ingestion API
ADMIN_SECRET_KEY=organic-admin-kisan-2026

# Vector Database (Local persistent directory or pgvector)
VECTOR_DB_TYPE=chromadb

# Supabase PostgreSQL (Optional for production cloud DB & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key

# Backend Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=true
